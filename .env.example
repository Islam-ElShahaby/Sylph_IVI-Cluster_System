# Sylph configuration. Copy to .env; run.sh sources it.
# The map is online-first with an offline fallback, so everything here is optional:
# with no keys and no signal it still runs entirely on the local data set.

# --- Online providers (preferred when reachable) ---
# Mapbox navigation basemap. Unset -> the offline Protomaps basemap is used.
#SYLPH_MAP_API_KEY=pk.xxxxxxxx
# Google Places search. Unset -> the local Photon geocoder is used.
#SYLPH_GOOGLE_API_KEY=AIzaxxxxxxxx
# Used only if the local routing service can't answer (e.g. destination
# outside the region your local graph was built for).
#SYLPH_OSRM_FALLBACK_URL=https://router.project-osrm.org

# --- CAN gateway (QNX TCP bridge) ---
#SYLPH_CAN_HOST=10.42.0.65
#SYLPH_CAN_PORT=5555

# --- Offline fallback (produced by tools/build-offline-data.sh) ---
#SYLPH_MAP_DIR=$HOME/.local/share/Sylph/Sylph/maps
#SYLPH_OSRM_URL=http://127.0.0.1:5000
#SYLPH_GEOCODER_URL=http://127.0.0.1:2322
